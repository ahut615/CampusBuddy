# ========== 数据库配置 ==========
MYSQL_ROOT_PASSWORD=changeme_mysql_password
MYSQL_DATABASE=campus_buddy
MYSQL_HOST=localhost
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://root:changeme_mysql_password@localhost:3306/campus_buddy

# 本地开发可用 SQLite 替代（无需安装 MySQL）
# DATABASE_URL=sqlite:///./campus_buddy.db

# ========== JWT 认证 ==========
JWT_SECRET=changeme_jwt_secret_replace_with_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ========== 前端 Mock 开关 ==========
# true=使用Mock数据独立开发前端，false=请求真实后端API
VITE_USE_MOCK=false

# ========== 前端 API 地址 ==========
VITE_API_BASE_URL=http://localhost:8000/api
